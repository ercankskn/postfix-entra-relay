# Dashboard/collector runtime values. Keep root-owned and mode 0640.
POSTFIX_ENTRA_ARCHIVE_ADDRESS=archive@example.com
# Optional defense in depth when the service is published without Nginx auth.
# POSTFIX_ENTRA_DASHBOARD_USER=operator
# POSTFIX_ENTRA_DASHBOARD_PASSWORD=<LONG_RANDOM_PASSWORD>
# Optional explicit Flask secret. If omitted, a persistent file is generated.
# POSTFIX_ENTRA_DASHBOARD_SECRET=<LONG_RANDOM_VALUE>
