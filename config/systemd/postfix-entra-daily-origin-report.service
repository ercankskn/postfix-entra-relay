[Unit]
Description=Postfix Entra Relay daily original sender report
After=network-online.target postfix.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/postfix-entra-daily-origin-report
User=root
Group=root
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/postfix-entra-relay
ReadOnlyPaths=/var/log /etc/postfix-entra-relay
