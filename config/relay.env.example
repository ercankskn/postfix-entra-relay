# Non-secret deployment variables used by helper scripts.
RELAY_HOSTNAME=mail-relay.example.net
HVE_ADDRESS=hve-relay@example.com
EXTERNAL_RELAY_ADDRESS=relay@example.com
ARCHIVE_ADDRESS=archive@example.com
ALERT_ADDRESS=alerts@example.com
HVE_DISPLAY_NAME=Application Mail Service
HVE_REPLY_TO=relay@example.com
HVE_CONFIG=/etc/postfix-entra-relay/hve-oauth.json
HVE_STATE_DIR=/var/lib/postfix-entra-relay
ACCEPTED_DOMAINS_FILE=/etc/postfix-entra-relay/accepted-domains.txt
